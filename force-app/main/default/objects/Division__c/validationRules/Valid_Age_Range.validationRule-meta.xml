<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valid_Age_Range</fullName>
    <active>true</active>
    <description
  >Ensures minimum age is less than or equal to maximum age</description>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Min_Age__c)),
    NOT(ISBLANK(Max_Age__c)),
    Min_Age__c &gt; Max_Age__c
)</errorConditionFormula>
    <errorDisplayField>Min_Age__c</errorDisplayField>
    <errorMessage
  >Minimum age must be less than or equal to maximum age.</errorMessage>
</ValidationRule>
