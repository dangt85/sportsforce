<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Save_Percentage__c</fullName>
    <label>Save Percentage</label>
    <type>Percent</type>
    <precision>5</precision>
    <scale>3</scale>
    <formula
  >IF(Saves__c + Goals_Against__c &gt; 0, Saves__c / (Saves__c + Goals_Against__c), 0)</formula>
    <description
  >Save percentage calculated as Saves / (Saves + Goals Against)</description>
</CustomField>
